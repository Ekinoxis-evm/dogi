# Copy to .env.local. Never commit real values.

NEXT_PUBLIC_APP_URL=http://localhost:3000        # https://dogi.ekinoxis.xyz in production

# Privy (dashboard.privy.io) -- login with email/Google, no wallets
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=                          # optional: verify tokens offline

# Supabase -- schema "dogi", server-only service role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago marketplace (mercadopago.com.co/developers -> your app)
MP_CLIENT_ID=                                    # the app's client id (APP_ID)
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=                               # Webhooks -> secret signature
MP_TEST_MODE=true                                # true = sandbox tokens + sandbox checkout

# Encrypts hosts' Mercado Pago tokens at rest: openssl rand -base64 32
DOGI_TOKEN_KEY=

# Agent chat via Vercel AI Gateway (OIDC on Vercel; AI_GATEWAY_API_KEY locally)
AI_GATEWAY_API_KEY=
DOGI_AGENT_MODEL=anthropic/claude-haiku-5-5
